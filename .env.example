# DeepSeek (or any OpenAI-compatible) credentials
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Default model — used by thinker (前台 IM 节奏), rewriter and brief.
# `deepseek-flash` is the documented ID (serves V4.1 Flash since 2026-09-10);
# `deepseek-v4-flash` is only a temporary alias for it now.
DEEPSEEK_MODEL=deepseek-flash
# Reasoner model — used by judge (元认知 / watching-the-watcher).
# Async metabolize, so seconds-to-minutes latency is acceptable.
DEEPSEEK_REASONER_MODEL=deepseek-v4-pro

# Per-role knobs (harness). DeepSeek enables thinking by default at effort
# "high", and while thinking is on `temperature` is ignored. Every role keeps
# it on by default, the thinker included: without it the replies came too
# fast to feel considered.
# ROLE is THINKER / REWRITER / BRIEF / JUDGE. Shown values are the defaults.
# COTHINKER_THINKER_THINKING=1
# COTHINKER_REWRITER_THINKING=1
# COTHINKER_REWRITER_EFFORT=high
# COTHINKER_THINKER_TEMPERATURE=1.0
# COTHINKER_THINKER_RETRIES=1
# COTHINKER_REWRITER_RETRIES=2
# Thinker context layout: `tail` = static prompt, then history, then the
# current 地基/scratchpad/plan right before the newest message, where the model
# reads most closely; `head` = the old layout with the state inside the system prompt.
# COTHINKER_CONTEXT_LAYOUT=tail
# Optional judge pass after each memory update.
# COTHINKER_JUDGE=0

# Backend
PORT=8000
LOG_LEVEL=INFO

# Path to SQLite session DB. Leave unset to use the in-memory store
# (sessions wiped on restart). Path is relative to the backend cwd, so
# ../cothinker.db lands at the project root and is gitignored. For
# Docker, compose sets this automatically to /data/cothinker.db.
# COTHINKER_DB=../cothinker.db

# CORS allowlist (comma-separated). Defaults to local Vite dev hosts.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
